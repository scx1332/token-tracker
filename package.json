{
  "name": "token-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ingest": "bun run src/ingestLoop.ts",
    "ingest-once": "bun run src/ingestLoop.ts --once",
    "gpu-once": "bun run src/gpuOnce.ts",
    "backfill": "bun run src/backfill.ts",
    "serve": "bun run src/serve.ts",
    "test": "bun test",
    "prod-check": "PROD_BASE_URL=${PROD_BASE_URL:-https://token-tracker.arkiv-global.net} bun test src/production.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/pg": "^8.20.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "pg": "^8.20.0"
  }
}
