# ---------------------------------------------------------------------------
# OpenRouter scraping
# ---------------------------------------------------------------------------
# API key used as a Bearer token when calling OpenRouter. The public model /
# pricing endpoints work without it, but sending it raises rate limits and
# unlocks the authenticated key/credits probes.
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here

# Base URL for OpenRouter (rarely changed).
OPENROUTER_BASE_URL=https://openrouter.ai

# ---------------------------------------------------------------------------
# Ingestion tuning
# ---------------------------------------------------------------------------
# How often the ingest loop runs a full pass. Default 1 hour.
INGEST_INTERVAL_MS=3600000
# Max concurrent requests when fetching per-provider endpoints.
INGEST_CONCURRENCY=6
# Politeness delay (ms) between provider-endpoint requests per worker.
INGEST_REQUEST_DELAY_MS=120
# Fetch per-provider endpoint pricing (slower, 1 request per model). Default true.
INGEST_FETCH_ENDPOINTS=true
# Ingest usage/ranking analytics from the OpenRouter frontend API. Default true.
INGEST_FETCH_USAGE=true
# Days of historical usage to backfill on `bun run backfill`.
BACKFILL_DAYS=120

# ---------------------------------------------------------------------------
# vast.ai GPU rental market (the "Compute" view)
# ---------------------------------------------------------------------------
# Sweep vast.ai for accelerator rental prices. Default true.
INGEST_FETCH_GPU=true
# GPU sweep cadence in ms, independent of the hourly OpenRouter pass — the
# offer book moves sub-hourly and a sweep is only ~50 requests. Default 15 min.
INGEST_GPU_INTERVAL_MS=900000
VASTAI_BASE_URL=https://console.vast.ai
# OPTIONAL and usually unnecessary. The live offer book (/api/v0/bundles/) that
# the price bands are built from is public — no key required. A key only unlocks
# the historical market-metrics endpoints, and only if it carries the
# `machine_read` permission group, which host accounts get and client accounts
# do not. An ordinary client key will 401 there; leave this blank in that case.
VASTAI_API_KEY=

# ---------------------------------------------------------------------------
# HTTP API server
# ---------------------------------------------------------------------------
SERVER_PORT=3000
SERVER_HOSTNAME=0.0.0.0

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=tokens
POSTGRES_PASSWORD=tokens
POSTGRES_DB=tokens

# ---------------------------------------------------------------------------
# Host ports exposed by docker compose (bound to 127.0.0.1). nginx proxies to
# these. Chosen to avoid collisions with other stacks on this host.
# ---------------------------------------------------------------------------
BACKEND_PORT=28470
FRONTEND_PORT=28471

# ---------------------------------------------------------------------------
# Backups. scripts/backup-db.sh writes archives to BACKUP_DIR_HOST; the backend
# mounts that directory read-only and serves the newest one at /backup/latest
# to whoever presents BACKUP_TOKEN as a bearer token. Leave BACKUP_TOKEN empty
# and the route 404s, as if it did not exist. The GitHub Action that verifies
# backups holds the same value as a repository secret.
# ---------------------------------------------------------------------------
BACKUP_DIR_HOST=/home/ubuntu/backups/token-tracker
BACKUP_TOKEN=replace-me-with-a-long-random-string
